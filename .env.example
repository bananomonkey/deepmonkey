# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token

# API-ключ DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# Базовый URL и стартовая модель DeepSeek (модель потом можно сменить через /admin)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Альтернативный провайдер LLM: Google Gemini (НЕОБЯЗАТЕЛЬНО) ---
# LLM_PROVIDER: "deepseek" (по умолчанию) или "gemini" — выбирает движок ответов.
LLM_PROVIDER=deepseek
# Ключ Gemini API (https://aistudio.google.com/apikey). Нужен только при LLM_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key
# Основная модель Gemini и vision-модель (для фото).
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# API-ключ Tavily для веб-поиска (https://tavily.com — бесплатно 1000 запросов/мес)
TAVILY_API_KEY=tvly-ваш_ключ

# Telegram user id администратора (узнать у @userinfobot)
ADMIN_ID=123456789

# --- База данных (SQLite) ---
# ВНИМАНИЕ: данные хранятся в SQLite, а не в JSON-файлах.
# На Bothost постоянная папка — /app/data (переживает деплой и рестарт контейнера).
# Локально можно указать data/bot.db
DB_FILE_PATH=/app/data/bot.db

# Пауза (в секундах) между сообщениями при массовой рассылке
BROADCAST_DELAY_SECONDS=0.05

# --- Антиспам: не более RATE_LIMIT_MESSAGES сообщений за RATE_LIMIT_WINDOW_SECONDS от одного пользователя ---
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# Каждые сколько сообщений в фоне обновлять заметку об интересах пользователя
PROFILE_UPDATE_EVERY_N_MESSAGES=6

# Сколько последних пар (пользователь/ассистент) хранить как контекст диалога
HISTORY_MAX_TURNS=12

# Максимум одновременных чатов на одного пользователя в личке
MAX_CHATS_PER_USER=5

# --- Юзербот (экспорт истории чата через личный Telegram-аккаунт) ---
# НЕОБЯЗАТЕЛЬНО: нужен только для чтения полной истории группы (до вступления
# бота). Bot API ботам этого не даёт — юзербот (Telethon-сессия личного
# аккаунта) экспортирует переписку в SQLite для портретов участников.
# Получить api_id/api_hash: https://my.telegram.org
USERBOT_API_ID=0
USERBOT_API_HASH=
# Путь к Telethon-сессии юзербота (без расширения .session)
USERBOT_SESSION_PATH=sessions/userbot_session
# Размер блока чтения и пауза между блоками (защита от бана аккаунта)
USERBOT_EXPORT_BATCH=100
USERBOT_EXPORT_DELAY=1.0
