# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token

# API-ключ DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# Базовый URL и стартовая модель DeepSeek (модель потом можно сменить через /admin)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# API-ключ Tavily для веб-поиска (https://tavily.com — бесплатно 1000 запросов/мес)
TAVILY_API_KEY=tvly-ваш_ключ

# Telegram user id администратора (узнать у @userinfobot)
ADMIN_ID=123456789

# --- Пути к файлам, где бот хранит данные между рестартами (можно не менять) ---
PROMPT_FILE_PATH=system_prompt.txt
MODEL_FILE_PATH=current_model.txt
USERS_FILE_PATH=users.json
CHATS_FILE_PATH=chats.json
REPLY_CONTEXT_FILE_PATH=reply_context.json

# Пауза (в секундах) между сообщениями при массовой рассылке
BROADCAST_DELAY_SECONDS=0.05

# --- Антиспам: не более RATE_LIMIT_MESSAGES сообщений за RATE_LIMIT_WINDOW_SECONDS от одного пользователя ---
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=20

# Каждые сколько сообщений в фоне обновлять заметку об интересах пользователя
PROFILE_UPDATE_EVERY_N_MESSAGES=6

# Сколько последних пар (пользователь/ассистент) хранить как контекст диалога
HISTORY_MAX_TURNS=12

# Максимум одновременных чатов на одного пользователя в личке
MAX_CHATS_PER_USER=5
